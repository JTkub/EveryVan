{
  "name": "everyvan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:install": "python -m pip install -r api/requirements.txt",
    "api": "python api/app.py",
    "start": "concurrently --names API,WEB --prefix-colors blue,green \"npm run api\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-test.mjs",
    "check": "npm run lint && npm run test && npm run build && python -m unittest discover -s api/tests -v",
    "preview": "vite preview"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "lucide-react": "^1.24.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.0.18",
    "jsdom": "^28.0.0"
  }
}
